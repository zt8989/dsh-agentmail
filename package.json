{
  "name": "@zt8989/dsh-agentmail",
  "version": "0.2.0",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "description": "Agent Mail for DeepSeek Harness: send and receive email through the agently-cli QQ Agent mailbox, embedding session/thread markers so replies are routed back to the right DSH Session.",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "dsh",
    "email",
    "agentmail",
    "agently"
  ],
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "dist/index.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "scripts": {
    "build": "esbuild index.js --bundle --format=esm --platform=node --outfile=dist/index.js --external:@deepseek-ai/cordis --external:@deepseek-ai/dsh-llm --external:@deepseek-ai/dsh-tools",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "turndown": "^7.2.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
